# eBay Browse API credentials (Application access token / client-credentials
# grant — no per-user OAuth needed for search). Get these from
# https://developer.ebay.com/my/keys after creating a keyset. Copy this file
# to .env and fill in real values; .env is gitignored and never committed.
# EBAY_ENV selects which eBay host the client talks to: "sandbox" (fake test
# data, safe for development) or "production" (real listings). Start on
# sandbox until the scanning job is verified, then switch to production.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
