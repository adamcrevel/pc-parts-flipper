{
  "name": "@pc-parts-flipper/server",
  "private": true,
  "version": "0.0.0",
  "description": "Fastify backend for pc-parts-flipper (DuckDB-backed, local-only).",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "backfill-photos": "tsx --env-file-if-exists=.env src/scripts/backfill-photos.ts",
    "backfill-descriptions": "tsx --env-file-if-exists=.env src/scripts/backfill-descriptions.ts",
    "seed-reference-photos": "tsx --env-file-if-exists=.env src/scripts/seed-reference-photos.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.4-r.4",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.5",
    "@pc-parts-flipper/shared": "*",
    "fastify": "^5.2.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
